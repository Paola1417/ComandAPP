PORT=3000

DB_HOST=localhost

DB_USER=root

DB_PASSWORD=your_password

DB_NAME=restaurante

DB_PORT=3306

# true en hosts gestionados que exigen TLS (Enzonic, RDS...); false en local/Docker.
DB_SSL=false

# alter = sincroniza tablas al arrancar (local). none = solo verifica la conexión (producción).
DB_SYNC=alter

# false = omite CREATE DATABASE al arrancar (recomendado en producción).
DB_INIT=true

# URL pública del API para las URLs de imágenes subidas. Vacío = se deduce del request.
PUBLIC_BASE_URL=

# Orígenes permitidos por CORS separados por coma. Vacío = todos.
CORS_ORIGIN=

# Directorio escribible para las imágenes subidas. Vacío = uploads/ del proyecto
# (o el directorio temporal si el código es de solo lectura, como en Enzonic Deploy).
UPLOADS_DIR=

JWT_SECRET=your_jwt_secret_key_here

JWT_EXPIRES_IN=8h

BCRYPT_SALT_ROUNDS=10

ADMIN_PASSWORD=admin123

COCINA_PASSWORD=cocina123
